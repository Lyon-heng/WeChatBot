    "sha256": "3aabdc267bacfe3a5d39ca1bea54dcc770812ee24f0eb81c8c2d849f673217ef",
    "url": "https://github.com/Lyon-heng/WeChatBot/releases/download/v1.10.0/WeChatBot-plugins-all-1.10.0.zip"
  }
}
