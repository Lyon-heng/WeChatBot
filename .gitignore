# Local accounts, credentials and runtime data
state/
data/
node_modules/
**/node_modules/
**/__pycache__/
*.pyc
.env
.env.*
!.env.example
config/*.json
!config/wechatagent.example.json
**/distribution.json
**/plugins.json
*.log
*.db
*.sqlite*
*.pem
*.key
*.pfx
*.exe
*.dll
*.pdb
*.obj
release/
dist/
build/

# Personal personas and installed plugin state
# Only the built-in plugins shipped with the app are tracked; anything else under
# plugins/ is local user state and must never be committed.
plugins/*
!plugins/moments-native/
!plugins/muse-video/
!plugins/voice-studio/
!plugins/workbuddy-memes/
!plugins/moments-native/native/bin/*.exe
!plugins/moments-native/native/bin/*.dll
!docs/plugins/
!docs/plugins/**
roles/*.md
!roles/示例助手.md
*.zip
!optional-extensions/packages/*.zip
!optional-extensions/packages/*.zip.sha256

# Editor/build scratch files
*.tmp
deployment.json
*.lib
*.exp
*.bak-*
